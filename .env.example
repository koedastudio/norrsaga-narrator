# Copy to .env and fill in. Compose sets KOKORO_URL and CACHE_DIR itself.

# Your Audiobookshelf server.
ABS_URL=http://abs.example.lan:13378

# Long-lived ABS API token (ABS: Settings → Users → your user → API token).
# Must belong to the SAME ABS user the app signs in as: progress is per user,
# and a mismatch splits resume points across two accounts.
ABS_TOKEN=

# Only needed outside docker compose.
KOKORO_URL=http://localhost:8880

# Kokoro voice, e.g. af_heart, af_bella, am_michael, bf_emma.
KOKORO_VOICE=af_heart

PORT=13379
LOG_LEVEL=info
